{
  "name": "all-the-content-changes/plugin",
  "description": "All the Content Changes WordPress plugin with Wikimedia thumbnail rewrite support",
  "type": "wordpress-plugin",
  "license": "GPL-2.0-or-later",
  "require": {
    "php": ">=8.0"
  },
  "require-dev": {
    "wp-coding-standards/wpcs": "^3.1",
    "phpcompatibility/phpcompatibility-wp": "^2.1",
    "phpunit/phpunit": "^9.6"
  },
  "scripts": {
    "lint": "phpcs --standard=phpcs.xml.dist .",
    "test": "phpunit -c phpunit.xml.dist",
    "build": [
      "rm -rf build/all-the-content-changes",
      "mkdir -p build/all-the-content-changes",
      "rm -f build/all-the-content-changes.zip",
      "rsync -a ./ build/all-the-content-changes/ --exclude '.git' --exclude '.github' --exclude '.gitignore' --exclude 'build' --exclude 'tests' --exclude 'vendor' --exclude 'node_modules' --exclude '.DS_Store' --exclude '.phpunit.result.cache' --exclude 'composer.lock' --exclude 'phpcs.xml.dist' --exclude 'phpunit.xml.dist'",
      "cd build && zip -r all-the-content-changes.zip all-the-content-changes && rm -rf all-the-content-changes"
    ]
  },
  "config": {
    "allow-plugins": {
      "dealerdirect/phpcodesniffer-composer-installer": true
    }
  }
}
