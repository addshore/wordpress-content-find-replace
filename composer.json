{
  "name": "addshore/wordpress-content-find-replace",
  "description": "WordPress content find/replace plugin with Wikimedia thumbnail rewrite support",
  "type": "wordpress-plugin",
  "license": "GPL-2.0-or-later",
  "require": {
    "php": ">=8.0"
  },
  "require-dev": {
    "wp-coding-standards/wpcs": "^3.1",
    "phpcompatibility/phpcompatibility-wp": "^2.1",
    "phpunit/phpunit": "^9.6"
  },
  "scripts": {
    "lint": "phpcs --standard=phpcs.xml.dist .",
    "test": "phpunit -c phpunit.xml.dist",
    "build": [
      "rm -rf build/wordpress-content-find-replace",
      "mkdir -p build/wordpress-content-find-replace",
      "rm -f build/wordpress-content-find-replace.zip",
      "rsync -a ./ build/wordpress-content-find-replace/ --exclude '.git' --exclude '.github' --exclude '.gitignore' --exclude 'build' --exclude 'tests' --exclude 'vendor' --exclude 'node_modules' --exclude '.DS_Store' --exclude '.phpunit.result.cache' --exclude 'composer.lock' --exclude 'phpcs.xml.dist' --exclude 'phpunit.xml.dist'",
      "cd build && zip -r wordpress-content-find-replace.zip wordpress-content-find-replace && rm -rf wordpress-content-find-replace"
    ]
  },
  "config": {
    "allow-plugins": {
      "dealerdirect/phpcodesniffer-composer-installer": true
    }
  }
}
